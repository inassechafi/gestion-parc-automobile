{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

<div class="row g-4">

    <!-- Immatriculation -->
    <div class="col-md-6">
        <div class="form-floating">
            {{ form_widget(form.immatriculation, {
                'attr': {
                    'class': 'form-control' ~ (form.immatriculation.vars.valid ? '' : ' is-invalid'),
                    'placeholder': 'AA-123-BB',
                    'autofocus': 'autofocus'
                }
            }) }}
            {{ form_label(form.immatriculation, null, {
                'label_attr': {'class': 'form-label fw-semibold'}
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.immatriculation) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Format : lettres, chiffres, tirets (ex: AB-123-CD)
            </div>
        </div>
    </div>

    <!-- Modèle -->
    <div class="col-md-6">
        <div class="form-floating">
            {{ form_widget(form.modele, {
                'attr': {
                    'class': 'form-control' ~ (form.modele.vars.valid ? '' : ' is-invalid'),
                    'placeholder': 'Peugeot 308, Renault Clio...'
                }
            }) }}
            {{ form_label(form.modele, null, {
                'label_attr': {'class': 'form-label fw-semibold'}
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.modele) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Modèle complet du véhicule
            </div>
        </div>
    </div>

    <!-- État - VERSION CORRIGÉE AVEC FORM-FLOATING -->
    <div class="col-md-6">
        <div class="form-floating">
            {{ form_widget(form.etat, {
                'attr': {
                    'class': 'form-select' ~ (form.etat.vars.valid ? '' : ' is-invalid'),
                    'data-choices': 'true'
                }
            }) }}
            {{ form_label(form.etat, null, {
                'label_attr': {'class': 'form-label fw-semibold'}
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.etat) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Statut actuel du véhicule
            </div>
        </div>
    </div>

    <!-- Kilométrage -->
    <div class="col-md-6">
        <div class="form-floating">
            {{ form_widget(form.kilometrage, {
                'attr': {
                    'class': 'form-control' ~ (form.kilometrage.vars.valid ? '' : ' is-invalid'),
                    'placeholder': '0',
                    'min': '0',
                    'step': '1'
                }
            }) }}
            {{ form_label(form.kilometrage, null, {
                'label_attr': {'class': 'form-label fw-semibold'}
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.kilometrage) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Kilométrage actuel en kilomètres
            </div>
        </div>
    </div>

</div>

<!-- Section des états avec badges - CORRIGÉ POUR MATCHER LA PAGE D'ÉDITION -->
<div class="mt-4 mb-4">
    <div class="card border-0 bg-light-subtle shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-info-circle-fill text-danger fs-5 me-2"></i>
                <h6 class="fw-semibold mb-0 text-danger">Signification des états</h6>
            </div>
            
            <div class="row g-3">
                <!-- Disponible -->
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-success">Disponible</div>
                            <div class="small text-muted">Prêt à l'utilisation</div>
                        </div>
                    </div>
                </div>
                
                <!-- En service - CORRIGÉ POUR ÊTRE EN BLEU -->
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-primary">En service</div>
                            <div class="small text-muted">Actuellement utilisé</div>
                        </div>
                    </div>
                </div>
                
                <!-- En panne -->
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-danger">En panne</div>
                            <div class="small text-muted">Nécessite réparation</div>
                        </div>
                    </div>
                </div>
                
                <!-- En entretien -->
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-tools"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-warning">En entretien</div>
                            <div class="small text-muted">En maintenance ou révision</div>
                        </div>
                    </div>
                </div>
                
                <!-- Hors service - CORRIGÉ POUR UTILISER bg-dark COMME DANS LA PAGE D'ÉDITION -->
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="bg-dark bg-opacity-10 text-dark rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-slash-circle-fill"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-dark">Hors service</div>
                            <div class="small text-muted">Désactivé temporairement</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Légende -->
            <div class="mt-3 pt-3 border-top">
                <div class="small text-muted">
                    <i class="bi bi-lightbulb text-warning me-1"></i>
                    Choisissez l'état approprié pour assurer un suivi précis du véhicule.
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<!-- Boutons d'action -->
<div class="d-flex justify-content-between align-items-center">
    <div>
        <a href="{{ path('app_vehicle_index') }}" 
           class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Retour à la liste</span>
        </a>
    </div>
    
    <div class="d-flex gap-3">
        <button type="reset" 
                class="btn btn-outline-danger d-flex align-items-center gap-2"
                id="resetBtn">
            <i class="bi bi-arrow-clockwise"></i>
            <span>Réinitialiser</span>
        </button>
        
        <button type="submit" 
                class="btn btn-danger d-flex align-items-center gap-2 px-4"
                id="submitBtn">
            <i class="bi bi-{{ button_icon|default('save') }}"></i>
            <span>{{ button_label|default('Enregistrer le véhicule') }}</span>
        </button>
    </div>
</div>

{{ form_end(form) }}

