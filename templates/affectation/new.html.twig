{% extends 'base.html.twig' %}

{% block title %}Nouvelle affectation - ParcAuto{% endblock %}

{% block page_icon 'person-plus' %}

{% block page_title %}Nouvelle affectation{% endblock %}

{% block page_description %}
    Affectez un véhicule à un employé pour une période définie
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_affectation_index') }}" class="btn btn-outline-secondary d-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>Retour à la liste</span>
    </a>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <!-- Carte principale du formulaire -->
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-white border-0 py-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 50px; height: 50px;">
                        <i class="bi bi-person-plus fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Nouvelle affectation</h5>
                        <p class="text-muted mb-0">
                            <i class="bi bi-info-circle me-1"></i>
                            Tous les champs marqués d'un <span class="text-danger">*</span> sont obligatoires
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="card-body p-4 p-lg-5">
                {{ form_start(form) }}
                    <div class="row g-4">
                        <!-- Véhicule -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                {{ form_label(form.vehicle, 'Véhicule', {
                                    'label_attr': {'class': 'form-label fw-semibold mb-3 text-dark'}
                                }) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger">
                                        <i class="bi bi-car-front"></i>
                                    </span>
                                    {{ form_widget(form.vehicle, {
                                        'attr': {
                                            'class': 'form-control border-start-0',
                                            'data-choices': 'true'
                                        }
                                    }) }}
                                </div>
                                {{ form_help(form.vehicle) }}
                                <div class="form-text text-muted small mt-1">
                                    Sélectionnez un véhicule disponible dans le parc
                                </div>
                            </div>
                        </div>

                        <!-- Conducteur -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                {{ form_label(form.conducteur, 'Conducteur', {
                                    'label_attr': {'class': 'form-label fw-semibold mb-3 text-dark'}
                                }) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-info bg-opacity-10 border-info border-opacity-25 text-info">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    {{ form_widget(form.conducteur, {
                                        'attr': {
                                            'class': 'form-control border-start-0',
                                            'data-choices': 'true'
                                        }
                                    }) }}
                                </div>
                                {{ form_help(form.conducteur) }}
                                <div class="form-text text-muted small mt-1">
                                    Sélectionnez un employé habilité
                                </div>
                            </div>
                        </div>

                        <!-- Date de début -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                {{ form_label(form.dateDebut, 'Date de début', {
                                    'label_attr': {'class': 'form-label fw-semibold mb-3 text-dark'}
                                }) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-primary bg-opacity-10 border-primary border-opacity-25 text-primary">
                                        <i class="bi bi-calendar-date"></i>
                                    </span>
                                    {{ form_widget(form.dateDebut, {
                                        'attr': {
                                            'class': 'form-control border-start-0',
                                            'placeholder': 'Sélectionnez une date'
                                        }
                                    }) }}
                                </div>
                                {{ form_help(form.dateDebut) }}
                                <div class="form-text text-muted small mt-1">
                                    Date de début de l'affectation
                                </div>
                            </div>
                        </div>

                        <!-- Date de fin -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                {{ form_label(form.dateFin, 'Date de fin (optionnelle)', {
                                    'label_attr': {'class': 'form-label fw-semibold mb-3 text-dark'}
                                }) }}
                                <div class="input-group">
                                    <span class="input-group-text bg-secondary bg-opacity-10 border-secondary border-opacity-25 text-secondary">
                                        <i class="bi bi-calendar-check"></i>
                                    </span>
                                    {{ form_widget(form.dateFin, {
                                        'attr': {
                                            'class': 'form-control border-start-0',
                                            'placeholder': 'Optionnel'
                                        }
                                    }) }}
                                </div>
                                {{ form_help(form.dateFin) }}
                                <div class="form-text text-muted small mt-1">
                                    Laissez vide si l'affectation est indéterminée
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center gap-3">
                                <a href="{{ path('app_affectation_index') }}" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                                    <i class="bi bi-x-circle"></i>
                                    Annuler
                                </a>
                                <button type="submit" class="btn btn-danger d-flex align-items-center gap-2 px-4 py-3">
                                    <i class="bi bi-person-plus"></i>
                                    Créer l'affectation
                                </button>
                            </div>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <!-- Guide d'aide -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-4">
                <h5 class="mb-0 text-danger fw-semibold">
                    <i class="bi bi-lightbulb me-2"></i>
                    Guide de saisie
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h6 class="fw-semibold mb-3 text-dark">
                        <i class="bi bi-card-checklist text-primary me-2"></i>
                        Champs obligatoires
                    </h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2">
                            <strong>Véhicule</strong> - Sélectionnez un véhicule disponible
                        </li>
                        <li class="mb-2">
                            <strong>Date de début</strong> - Date de début d'affectation
                        </li>
                        <li>
                            <strong>Conducteur</strong> - Sélectionnez l'employé concerné
                        </li>
                    </ul>
                </div>
                
                <div class="mb-4">
                    <h6 class="fw-semibold mb-3 text-dark">
                        <i class="bi bi-star text-warning me-2"></i>
                        Recommandations
                    </h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2">
                            Vérifiez la disponibilité du véhicule
                        </li>
                        <li class="mb-2">
                            Prévoyez une date de fin si l'affectation est temporaire
                        </li>
                        <li>
                            Consultez l'historique des affectations du conducteur
                        </li>
                    </ul>
                </div>
                
                <div>
                    <h6 class="fw-semibold mb-3 text-dark">
                        <i class="bi bi-shield-check text-success me-2"></i>
                        Vérifications automatiques
                    </h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2">
                            Véhicule disponible uniquement
                        </li>
                        <li class="mb-2">
                            Pas de chevauchement d'affectations
                        </li>
                        <li>
                            Conducteur habilité au type de véhicule
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Lien rapide -->
        <div class="card border-0 bg-danger bg-opacity-5 border-start border-4 border-danger">
            <div class="card-body p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 40px; height: 40px;">
                        <i class="bi bi-question-circle"></i>
                    </div>
                    <div class="small">
                        <div class="fw-semibold">Conflits d'affectation ?</div>
                        <div class="text-muted">
                            Le système vérifie automatiquement les disponibilités et prévient en cas de conflit.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
    }
    
    .bg-danger.bg-opacity-5 {
        background-color: rgba(220, 38, 38, 0.05) !important;
    }
    
    .border-danger {
        border-color: #dc2626 !important;
    }
    
    .form-control.is-valid {
        border-color: #10b981;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2310b981' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    
    .alert {
        border-radius: 8px;
        border: none;
    }
    
    .btn-sm {
        padding: 0.375rem 0.875rem;
        font-size: 0.875rem;
    }
    
    .list-unstyled li {
        margin-bottom: 0.5rem;
    }
    
    .bg-light.rounded {
        border-radius: 8px !important;
    }
    
    .border-bottom {
        border-bottom: 1px solid #e9ecef !important;
    }
    
    .input-group-text {
        border-right: none;
    }
    
    .form-control.border-start-0 {
        border-left: none;
    }
</style>
{% endblock %}