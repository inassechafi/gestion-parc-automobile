{% extends 'base.html.twig' %}

{% block title %}Affectations - ParcAuto{% endblock %}

{% block page_icon 'person-badge' %}

{% block page_title %}Gestion des Affectations{% endblock %}

{% block page_description %}
    Consultez et gérez les affectations véhicules/conducteurs
{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_affectation_new') }}" 
       class="btn btn-danger d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>Nouvelle affectation</span>
    </a>
{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 bg-danger bg-opacity-5">
            <div class="card-body p-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <h6 class="mb-1 text-danger fw-semibold">
                            <i class="bi bi-info-circle me-2"></i>
                            Aperçu des affectations
                        </h6>
                        <div class="d-flex flex-wrap gap-4">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">
                                    <i class="bi bi-person-badge me-1"></i>
                                    {{ affectations|length }} affectation(s)
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-filter"></i>
                            Filtrer
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-download"></i>
                            Exporter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase small">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold text-muted border-0">ID</th>
                        <th class="py-3 fw-semibold text-muted border-0">Véhicule</th>
                        <th class="py-3 fw-semibold text-muted border-0">Conducteur</th>
                        <th class="py-3 fw-semibold text-muted border-0">Date début</th>
                        <th class="py-3 fw-semibold text-muted border-0">Date fin</th>
                        <th class="py-3 fw-semibold text-muted border-0">Statut</th>
                        <th class="py-3 fw-semibold text-muted border-0 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                
                <tbody>
                {% for affectation in affectations %}
                    <tr class="border-bottom">
                        <td class="ps-4 py-3">
                            <div class="fw-semibold text-dark">#{{ affectation.id }}</div>
                        </td>

                        <td class="py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 32px; height: 32px;">
                                    <i class="bi bi-car-front"></i>
                                </div>
                                <div>
                                    {% if affectation.vehicle is defined and affectation.vehicle is not null %}
                                        <div class="fw-semibold">{{ affectation.vehicle.immatriculation }}</div>
                                        <div class="small text-muted">{{ affectation.vehicle.modele }}</div>
                                    {% else %}
                                        <div class="fw-semibold text-muted">Véhicule non défini</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>

                        <td class="py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 32px; height: 32px;">
                                    <i class="bi bi-person"></i>
                                </div>
                                <div>
                                    {% if affectation.conducteur is defined and affectation.conducteur is not null %}
                                        <div class="fw-semibold">{{ affectation.conducteur.prenom }} {{ affectation.conducteur.nom }}</div>
                                        <div class="small text-muted">
                                            {{ affectation.conducteur.email }}
                                        </div>
                                    {% else %}
                                        <div class="fw-semibold text-muted">Conducteur non défini</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>

                        <td class="py-3">
                            <div class="fw-medium text-dark">
                                {{ affectation.dateDebut ? affectation.dateDebut|date('d/m/Y') : '—' }}
                            </div>
                            <div class="small text-muted">
                                {{ affectation.dateDebut ? affectation.dateDebut|date('H:i') : '' }}
                            </div>
                        </td>

                        <td class="py-3">
                            {% if affectation.dateFin %}
                                <div class="fw-medium text-dark">
                                    {{ affectation.dateFin|date('d/m/Y') }}
                                </div>
                                <div class="small text-muted">
                                    {{ affectation.dateFin|date('H:i') }}
                                </div>
                            {% else %}
                                <div class="text-muted small fst-italic">
                                    Non définie
                                </div>
                            {% endif %}
                        </td>

                        <td class="py-3">
                            {% set statut = affectation.statut %}
                            
                            {% if statut == 'Terminé' %}
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-check-circle-fill fs-6"></i>
                                    Terminée
                                </span>
                                {% if affectation.dateFin %}
                                    {% set diff = date(affectation.dateFin).diff(date('now')) %}
                                    <div class="mt-1 small text-muted">
                                        {% if diff.days > 0 %}
                                            Il y a {{ diff.days }} jour{{ diff.days > 1 ? 's' : '' }}
                                        {% else %}
                                            Aujourd'hui
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% elseif statut == 'En cours' %}
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-play-circle-fill fs-6"></i>
                                    En cours
                                </span>
                                {% set diff = date('now').diff(date(affectation.dateDebut)) %}
                                <div class="mt-1 small text-muted">
                                    Depuis 
                                    {% if diff.days > 0 %}
                                        {{ diff.days }} jour{{ diff.days > 1 ? 's' : '' }}
                                    {% elseif diff.h > 0 %}
                                        {{ diff.h }} heure{{ diff.h > 1 ? 's' : '' }}
                                    {% else %}
                                        {{ diff.i }} minute{{ diff.i > 1 ? 's' : '' }}
                                    {% endif %}
                                </div>
                            {% else %}
                                {# À venir #}
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-clock-fill fs-6"></i>
                                    À venir
                                </span>
                                {% set diff = date(affectation.dateDebut).diff(date('now')) %}
                                <div class="mt-1 small text-muted">
                                    Débute dans
                                    {% if diff.days > 0 %}
                                        {{ diff.days }} jour{{ diff.days > 1 ? 's' : '' }}
                                    {% elseif diff.h > 0 %}
                                        {{ diff.h }} heure{{ diff.h > 1 ? 's' : '' }}
                                    {% else %}
                                        {{ diff.i }} minute{{ diff.i > 1 ? 's' : '' }}
                                    {% endif %}
                                </div>
                            {% endif %}
                        </td>

                        <td class="text-end pe-4 py-3">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="{{ path('app_affectation_show', {'id': affectation.id}) }}"
                                   class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1"
                                   data-bs-toggle="tooltip"
                                   title="Voir les détails">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-md-inline">Détails</span>
                                </a>

                                <a href="{{ path('app_affectation_edit', {'id': affectation.id}) }}"
                                   class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                                   data-bs-toggle="tooltip"
                                   title="Modifier l'affectation">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-md-inline">Modifier</span>
                                </a>

                                <a href="{{ path('app_affectation_delete_confirm', {'id': affectation.id}) }}"
                                class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1"
                                data-bs-toggle="tooltip"
                                title="Supprimer l'affectation">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-md-inline">Supprimer</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="py-5">
                                <div class="text-muted mb-3">
                                    <i class="bi bi-person-badge display-6"></i>
                                </div>
                                <h4 class="text-muted mb-2">Aucune affectation trouvée</h4>
                                <p class="text-muted mb-4">Créez votre première affectation véhicule/conducteur</p>
                                <a href="{{ path('app_affectation_new') }}" class="btn btn-danger">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Nouvelle affectation
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    
    {% if affectations|length > 0 %}
    <div class="card-footer bg-white border-0 border-top pt-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                Affichage de {{ affectations|length }} affectation(s)
            </div>
            
            {# Stats rapides utilisant getStatut() #}
            <div class="d-flex gap-3">
                <div class="text-muted small">
                    <i class="bi bi-play-circle-fill text-success me-1"></i>
                    {{ affectations|filter(a => a.statut == 'En cours')|length }} active(s)
                </div>
                <div class="text-muted small">
                    <i class="bi bi-check-circle-fill text-secondary me-1"></i>
                    {{ affectations|filter(a => a.statut == 'Terminé')|length }} terminée(s)
                </div>
                <div class="text-muted small">
                    <i class="bi bi-clock-fill text-warning me-1"></i>
                    {{ affectations|filter(a => a.statut == 'À venir')|length }} à venir
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<style>
    .table tbody tr {
        transition: background-color 0.15s ease;
    }
    
    .table tbody tr:hover {
        background-color: rgba(220, 38, 38, 0.03);
    }
    
    .badge {
        font-weight: 500;
        letter-spacing: 0.3px;
    }
    
    .btn-sm {
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
    }
    
    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    /* Animation pour les badges de statut */
    .badge.bg-success {
        animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.4); }
        70% { box-shadow: 0 0 0 6px rgba(25, 135, 84, 0); }
        100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }
</style>
{% endblock %}