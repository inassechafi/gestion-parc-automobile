{# templates/entretien/_form.html.twig #}

{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

<div class="row g-4">
    <!-- Véhicule -->
    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label fw-semibold d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-car-front text-danger"></i>
                Véhicule concerné <span class="text-danger">*</span>
            </label>
            {{ form_widget(form.vehicle, {
                'attr': {
                    'class': 'form-select',
                    'required': 'required'
                }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.vehicle) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Sélectionnez le véhicule concerné par l'entretien
            </div>
        </div>
    </div>

    <!-- Date -->
    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label fw-semibold d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-calendar-event text-danger"></i>
                Date et heure <span class="text-danger">*</span>
            </label>
            {{ form_widget(form.date, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Date de l\'entretien',
                    'required': 'required'
                }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(form.date) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Date de réalisation de l'intervention
            </div>
        </div>
    </div>

    <!-- Type - CHAMP CRITIQUE -->
    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label fw-semibold d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-tools text-danger"></i>
                Type d'entretien <span class="text-danger">*</span>
            </label>
            {{ form_widget(form.type, {
                'attr': {
                    'class': 'form-select',
                    'required': 'required'
                }
            }) }}
            <div class="invalid-feedback d-block">
                {{ form_errors(form.type) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Nature de l'intervention (obligatoire)
            </div>
        </div>
    </div>

    <!-- Coût -->
    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label fw-semibold d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-cash-coin text-danger"></i>
                Coût (DH) <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                {{ form_widget(form.cout, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': '0.00',
                        'step': '0.01',
                        'min': '0',
                        'required': 'required'
                    }
                }) }}
                <span class="input-group-text">DH</span>
            </div>
            <div class="invalid-feedback">
                {{ form_errors(form.cout) }}
            </div>
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Coût total de l'intervention
            </div>
        </div>
    </div>

    <!-- Description -->
    <div class="col-12">
        <div class="mb-3">
            <label class="form-label fw-semibold d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-card-text text-primary"></i>
                Description
            </label>
            {{ form_widget(form.description, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Détails des travaux effectués...',
                    'rows': '4'
                }
            }) }}
            <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Décrivez précisément l'intervention réalisée (optionnel)
            </div>
        </div>
    </div>
</div>

<!-- Section des types avec badges -->
<div class="mt-4 mb-4">
    <div class="card border-0 bg-light-subtle shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
                <i class="bi bi-info-circle-fill text-danger fs-5 me-2"></i>
                <h6 class="fw-semibold mb-0 text-danger">Signification des types d'entretien</h6>
            </div>
            
            <div class="row g-2">
                <div class="col-12 col-md-6 mb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-gear-fill"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-primary">Révision</div>
                            <div class="small text-muted">Maintenance programmée</div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-md-6 mb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-tools"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-danger">Réparation</div>
                            <div class="small text-muted">Correction de panne</div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-md-6 mb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-wrench"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-warning">Entretien</div>
                            <div class="small text-muted">Maintenance courante</div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-md-6 mb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-clipboard-check"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-info">Contrôle technique</div>
                            <div class="small text-muted">Vérification réglementaire</div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-md-6 mb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-droplet-fill"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-success">Vidange</div>
                            <div class="small text-muted">Changement d'huile et filtres</div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-md-6 mb-2">
                    <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px; min-width: 40px;">
                            <i class="bi bi-three-dots"></i>
                        </div>
                        <div>
                            <div class="fw-semibold text-secondary">Autre</div>
                            <div class="small text-muted">Autre type d'intervention</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Légende -->
            <div class="mt-3 pt-3 border-top">
                <div class="small text-muted">
                    <i class="bi bi-lightbulb text-warning me-1"></i>
                    Choisissez le type approprié pour assurer un suivi précis de la maintenance.
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">

<!-- Boutons d'action -->
<div class="d-flex justify-content-between align-items-center">
    <div>
        <a href="{{ path('app_entretien_index') }}" 
           class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Retour à la liste</span>
        </a>
    </div>
    
    <div class="d-flex gap-3">
        <button type="reset" 
                class="btn btn-outline-danger d-flex align-items-center gap-2"
                id="resetBtn">
            <i class="bi bi-arrow-clockwise"></i>
            <span>Réinitialiser</span>
        </button>
        
        <button type="submit" 
                class="btn btn-danger d-flex align-items-center gap-2 px-4"
                id="submitBtn">
            <i class="bi bi-{{ button_icon|default('plus-circle') }}"></i>
            <span>{{ button_label|default('Enregistrer l\'entretien') }}</span>
        </button>
    </div>
</div>

{{ form_end(form) }}

<style>
    .form-control, .form-select {
        border-radius: 8px;
        border: 2px solid #e5e7eb;
        padding: 0.75rem 1rem;
        transition: all 0.2s ease;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 0.25rem rgba(220, 38, 38, 0.25);
        outline: none;
    }
    
    .form-control.is-invalid, .form-select.is-invalid {
        border-color: #dc3545;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    
    .form-control.is-invalid:focus, .form-select.is-invalid:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }
    
    .form-control.is-valid, .form-select.is-valid {
        border-color: #10b981;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2310b981' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    
    .invalid-feedback {
        display: block;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
    
    .form-text {
        font-size: 0.875rem;
        margin-top: 0.25rem;
        color: #6c757d;
    }
    
    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
    }
    
    .btn {
        border-radius: 8px;
        padding: 0.625rem 1.5rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    
    .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
    }
    
    .btn-danger:hover:not(:disabled) {
        background-color: #b91c1c;
        border-color: #b91c1c;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
    }
    
    .btn-danger:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
    
    .btn-outline-danger:hover {
        background-color: rgba(220, 38, 38, 0.1);
        color: #dc2626;
    }
    
    .card {
        border-radius: 12px;
    }
    
    hr {
        border: none;
        height: 1px;
        background: linear-gradient(90deg, transparent, #e5e7eb, transparent);
    }
    
    .input-group-text {
        background-color: #f8f9fa;
        border: 2px solid #e5e7eb;
        border-left: none;
        border-radius: 0 8px 8px 0;
    }
    
    .input-group .form-control {
        border-right: none;
        border-radius: 8px 0 0 8px;
    }
    
    /* Style pour le sélecteur de type */
    #{{ form.type.vars.id }}.is-invalid {
        border-color: #dc3545 !important;
        background-color: #fff8f8 !important;
    }
    
    #{{ form.type.vars.id }} option[value=""] {
        color: #dc3545;
        font-weight: bold;
    }
</style>