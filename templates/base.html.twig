<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestion Parc Auto{% endblock %}</title>

    <!-- Bootstrap 5 avec thème personnalisé -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- CSS personnalisé -->
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">

    {% block stylesheets %}{% endblock %}

    <style>
        :root {
            --bs-primary: #dc2626;
            --bs-primary-rgb: 220, 38, 38;
            --bs-secondary: #6c757d;
            --bs-light: #f8f9fa;
            --bs-dark: #212529;
            --bs-border-radius: 8px;
            --bs-border-radius-lg: 14px;
        }
        
        .bg-primary { background-color: var(--bs-primary) !important; }
        .btn-primary { 
            background-color: var(--bs-primary) !important;
            border-color: var(--bs-primary) !important;
        }
        .btn-primary:hover {
            background-color: #b91c1c !important;
            border-color: #b91c1c !important;
        }
        .border-primary { border-color: var(--bs-primary) !important; }
        .text-primary { color: var(--bs-primary) !important; }
    </style>
</head>

<body class="d-flex flex-column min-vh-100 bg-light">

<!-- 🔝 NAVBAR - Version améliorée -->
<nav class="navbar navbar-expand-lg navbar-white bg-white shadow-sm py-3 sticky-top">
    <div class="container">

        {# Logo / Nom #}
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-danger"
            href="{{ app.user ? 
                (is_granted('ROLE_ADMIN') ? path('app_dashboard') : path('app_mes_affectations')) 
                : path('app_login') }}">            
            <i class="bi bi-car-front-fill fs-4"></i>
            <span class="fs-5">ParcAuto</span>
        </a>

        {# Bouton mobile #}
        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-label="Toggle navigation">
            <i class="bi bi-list text-danger fs-4"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            {# Menu principal #}
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                {% if is_granted('ROLE_ADMIN') %}
                    {# === MENU COMPLET POUR ADMIN === #}
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 
                                  {{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active bg-danger bg-opacity-10 text-danger fw-semibold' : 'text-gray-700' }}"
                           href="{{ path('app_dashboard') }}">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 
                                  {{ app.request.attributes.get('_route') starts with 'app_vehicle' ? 'active bg-danger bg-opacity-10 text-danger fw-semibold' : 'text-gray-700' }}"
                           href="{{ path('app_vehicle_index') }}">
                            <i class="bi bi-truck"></i>
                            <span>Véhicules</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 
                                  {{ app.request.attributes.get('_route') starts with 'app_affectation' ? 'active bg-danger bg-opacity-10 text-danger fw-semibold' : 'text-gray-700' }}"
                           href="{{ path('app_affectation_index') }}">
                            <i class="bi bi-person-badge"></i>
                            <span>Affectations</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 
                                  {{ app.request.attributes.get('_route') starts with 'app_entretien' ? 'active bg-danger bg-opacity-10 text-danger fw-semibold' : 'text-gray-700' }}"
                           href="{{ path('app_entretien_index') }}">
                            <i class="bi bi-tools"></i>
                            <span>Entretiens</span>
                        </a>
                    </li>
                
                {% elseif is_granted('ROLE_USER') %}
                    {# === MENU MINIMAL POUR CONDUCTEUR === #}
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-3 
                                  {{ app.request.attributes.get('_route') starts with 'app_mes_affectations' ? 'active bg-danger bg-opacity-10 text-danger fw-semibold' : 'text-gray-700' }}"
                           href="{{ path('app_mes_affectations') }}">
                            <i class="bi bi-calendar-check"></i>
                            <span>Mes affectations</span>
                        </a>
                    </li>
                {% endif %}
            </ul>

            {# Utilisateur #}
            <div class="navbar-nav ms-auto align-items-center gap-3">
                {% if app.user %}
                    <div class="nav-item d-flex align-items-center gap-2 px-3 py-2 bg-light rounded-3">
                        <div class="user-avatar bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 36px; height: 36px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="d-none d-lg-flex flex-column">
                            <span class="small text-muted">
                                {% if is_granted('ROLE_ADMIN') %}
                                    Administrateur
                                {% else %}
                                    Conducteur
                                {% endif %}
                            </span>
                            <strong class="text-dark small">
                                {{ app.user.prenom }} {{ app.user.nom }}
                            </strong>
                        </div>
                    </div>

                    <li class="nav-item">
                        <a class="btn btn-outline-danger d-flex align-items-center gap-2"
                           href="{{ path('app_logout') }}">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-lg-inline">Déconnexion</span>
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="btn btn-danger d-flex align-items-center gap-2"
                           href="{{ path('app_login') }}">
                            <i class="bi bi-lock-fill"></i>
                            <span>Connexion</span>
                        </a>
                    </li>
                {% endif %}
            </div>

        </div>
    </div>
</nav>

<!-- 📄 CONTENU PRINCIPAL -->
<main class="container my-4 my-lg-5 flex-grow-1">
    {% block flash_messages %}
        {% for type, messages in app.flashes %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow-sm border-start-4 border-{{ type == 'error' ? 'danger' : type }} mb-4"
                 role="alert">
                <div class="d-flex align-items-center gap-2">
                    {% if type == 'success' %}
                        <i class="bi bi-check-circle-fill"></i>
                    {% elseif type == 'error' or type == 'danger' %}
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    {% elseif type == 'warning' %}
                        <i class="bi bi-exclamation-circle-fill"></i>
                    {% elseif type == 'info' %}
                        <i class="bi bi-info-circle-fill"></i>
                    {% endif %}
                    <div>
                        {% for message in messages %}
                            <p class="mb-0">{{ message|raw }}</p>
                        {% endfor %}
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endblock %}

    {% block content_wrapper %}
        <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="card-header bg-white border-0 py-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h3 mb-0 text-dark fw-bold">
                            <i class="bi bi-{% block page_icon 'grid' %} text-danger me-2"></i>
                            {% block page_title %}{% endblock %}
                        </h1>
                        {% block page_subtitle %}
                            <p class="text-muted mb-0 mt-1 small">
                                {% block page_description %}{% endblock %}
                            </p>
                        {% endblock %}
                    </div>
                    {% block page_actions %}{% endblock %}
                </div>
            </div>
            
            <div class="card-body p-4 p-lg-5">
                {% block body %}{% endblock %}
            </div>
            
            {% block card_footer %}
                {% if block('card_footer_content') is defined %}
                    <div class="card-footer bg-light border-0 py-3">
                        {% block card_footer_content %}{% endblock %}
                    </div>
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
</main>

<!-- 🔻 FOOTER -->
<footer class="bg-white border-top py-4 mt-auto">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <p class="mb-0 text-muted">
                    <i class="bi bi-car-front text-danger me-1"></i>
                    <strong>ParcAuto</strong> – Système de gestion de parc automobile
                </p>
            </div>
            <div class="col-md-6 text-md-end">
                <p class="mb-0 text-muted small">
                    © {{ "now"|date("Y") }} – Tous droits réservés
                    <span class="mx-1">•</span>
                    v1.0.0
                </p>
            </div>
        </div>
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}

</body>
</html>