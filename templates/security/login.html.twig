{% extends 'base.html.twig' %}

{% block title %}Connexion - ParcAuto{% endblock %}

{% block body_class 'bg-light' %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
        
            <!-- Carte de connexion -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-white border-0 text-center py-4">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 80px; height: 80px;">
                            <i class="bi bi-shield-lock fs-1"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-danger mb-1">Connexion</h2>
                    <p class="text-muted mb-0">Accédez à votre espace de gestion</p>
                </div>
                
                <div class="card-body p-4 p-lg-5">
                    {% if error %}
                        <div class="alert alert-danger border-danger border-start border-4 d-flex align-items-center gap-3">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>
                                <strong>Erreur d'authentification</strong>
                                <div class="small mt-1">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info border-info border-start border-4 d-flex align-items-center gap-3">
                            <i class="bi bi-info-circle-fill fs-5"></i>
                            <div>
                                <div>Vous êtes déjà connecté en tant que</div>
                                <strong class="d-block mt-1">{{ app.user.userIdentifier }}</strong>
                                <div class="mt-2">
                                    <a href="{{ logout_path() }}" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Se déconnecter
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <form method="post">
                        <!-- Email -->
                        <div class="mb-4">
                            <label for="inputEmail" class="form-label fw-semibold d-flex align-items-center gap-2">
                                <i class="bi bi-envelope text-danger"></i>
                                Adresse email
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-person text-muted"></i>
                                </span>
                                <input type="email"
                                       value="{{ last_username }}"
                                       name="email"
                                       id="inputEmail"
                                       class="form-control border-start-0 ps-0"
                                       placeholder="exemple@entreprise.com"
                                       autocomplete="email"
                                       required
                                       autofocus>
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Saisissez votre adresse email professionnelle
                            </div>
                        </div>

                        <!-- Mot de passe -->
                        <div class="mb-4">
                            <label for="inputPassword" class="form-label fw-semibold d-flex align-items-center gap-2">
                                <i class="bi bi-key text-danger"></i>
                                Mot de passe
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock text-muted"></i>
                                </span>
                                <input type="password"
                                       name="password"
                                       id="inputPassword"
                                       class="form-control border-start-0 ps-0"
                                       placeholder="Votre mot de passe"
                                       autocomplete="current-password"
                                       required>
                                <button class="btn btn-outline-secondary border-start-0" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                Minimum 8 caractères
                            </div>
                        </div>

                        <!-- Options -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="_remember_me"
                                       id="rememberMe">
                                <label class="form-check-label fw-semibold" for="rememberMe">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Se souvenir de moi sur cet appareil
                                </label>
                            </div>
                        </div>

                        <!-- Token CSRF -->
                        <input type="hidden"
                               name="_csrf_token"
                               value="{{ csrf_token('authenticate') }}">

                        <!-- Bouton de connexion -->
                        <button type="submit" class="btn btn-danger btn-lg w-100 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Se connecter</span>
                        </button>
                    </form>

                    <!-- Séparateur -->
                    <div class="my-4">
                        <div class="d-flex align-items-center">
                            <hr class="flex-grow-1">
                            <span class="px-3 text-muted small">Ou</span>
                            <hr class="flex-grow-1">
                        </div>
                    </div>

                    <!-- Lien mot de passe oublié -->
                    <div class="text-center">
                        <a href="#" class="text-danger fw-semibold text-decoration-none d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-question-circle"></i>
                            <span>Mot de passe oublié ?</span>
                        </a>
                        <div class="small text-muted mt-2">
                            Contactez l'administrateur système
                        </div>
                    </div>
                </div>
                
                <!-- Footer de la carte -->
                <div class="card-footer bg-white border-0 pt-0 pb-4">
                    <div class="text-center">
                        <div class="small text-muted">
                            <i class="bi bi-shield-check me-1"></i>
                            Votre connexion est sécurisée et cryptée
                        </div>
                    </div>
                </div>
            </div>

            <!-- Informations de sécurité -->
            <div class="card border-0 bg-light mt-4">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 40px; height: 40px;">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <div class="small">
                            <div class="fw-semibold">Conseils de sécurité</div>
                            <div class="text-muted">
                                Ne partagez jamais vos identifiants et déconnectez-vous après utilisation.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script uniquement pour le toggle du mot de passe -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle du mot de passe
        const togglePassword = document.getElementById('togglePassword');
        const togglePasswordIcon = document.getElementById('togglePasswordIcon');
        const passwordInput = document.getElementById('inputPassword');
        
        if (togglePassword && passwordInput) {
            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                
                // Changer l'icône
                if (type === 'text') {
                    togglePasswordIcon.classList.remove('bi-eye');
                    togglePasswordIcon.classList.add('bi-eye-slash');
                } else {
                    togglePasswordIcon.classList.remove('bi-eye-slash');
                    togglePasswordIcon.classList.add('bi-eye');
                }
            });
        }
    });
</script>

<style>
    body.bg-light {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }
    
    .card {
        border-radius: 16px;
    }
    
    .card-header {
        border-radius: 16px 16px 0 0 !important;
    }
    
    .form-control {
        border-radius: 8px;
        border: 2px solid #e5e7eb;
        padding: 0.75rem 1rem;
        transition: all 0.2s ease;
    }
    
    .form-control:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 0.25rem rgba(220, 38, 38, 0.25);
        outline: none;
    }
    
    .input-group-text {
        border-radius: 8px 0 0 8px;
        background-color: #f8f9fa;
        border: 2px solid #e5e7eb;
        border-right: none;
    }
    
    .form-control.border-start-0 {
        border-left: none;
    }
    
    .btn-danger {
        background-color: #dc2626;
        border-color: #dc2626;
        padding: 0.875rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }
    
    .btn-danger:hover {
        background-color: #b91c1c;
        border-color: #b91c1c;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
    }
    
    .btn-outline-secondary {
        border-radius: 0 8px 8px 0;
        border: 2px solid #e5e7eb;
        border-left: none;
    }
    
    .btn-outline-secondary:hover {
        background-color: #f8f9fa;
        border-color: #dc2626;
    }
    
    .form-check-input:checked {
        background-color: #dc2626;
        border-color: #dc2626;
    }
    
    .form-check-input:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 0.25rem rgba(220, 38, 38, 0.25);
    }
    
    .alert {
        border-radius: 8px;
        border: none;
    }
    
    .border-danger {
        border-color: #dc2626 !important;
    }
    
    .border-info {
        border-color: #0dcaf0 !important;
    }
    
    .fs-1 {
        font-size: 3rem !important;
    }
    
    .bg-opacity-10 {
        opacity: 0.1;
    }
    
    .text-decoration-none:hover {
        text-decoration: underline !important;
    }
</style>
{% endblock %}